{
  "name": "local-kiro-adapter",
  "version": "1.0.0",
  "private": true,
  "description": "Local Anthropic Messages API adapter for a pooled set of Kiro accounts",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch --experimental-transform-types src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "axios": "^1.10.0",
    "cbor-x": "^1.6.0",
    "echarts": "^5.6.0",
    "express": "^5.1.0",
    "https-proxy-agent": "^7.0.6",
    "lucide": "^0.511.0",
    "notyf": "^3.10.0",
    "socks-proxy-agent": "^8.0.5",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  }
}
